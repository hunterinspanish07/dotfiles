{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-remote:*)",
      "Bash(git branch --show-current)",
      "Bash(lit quickstart)",
      "Bash(lit show:*)",
      "Bash(lit ls:*)",
      "Bash(lit ready:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(~/.claude/skills/lib/integration-branch.sh)",
      "Bash(lit queue:*)",
      "Bash(~/.claude/skills/lib/autonomy-grant.py status:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tts-stop-hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-code-discovery-gate",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-bash-search-augment",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "laws@promptctl": true
  },
  "extraKnownMarketplaces": {
    "promptctl": {
      "source": {
        "source": "directory",
        "path": "/Users/hhouse/code/dotfiles/config/claude/vendor/laws"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "medium",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "auto",
  "editorMode": "normal",
  "preferredNotifChannel": "iterm2_with_bell",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "`gh pr merge` on a pull request whose ticket is covered by an active `/auto` autonomy grant, OR when the conversation shows an explicit user instruction to merge. The PR need NOT have been opened in this session — under orchestration the agent that opens a PR and the agent that merges it are different processes by design, so a session-scoped test would block every legitimate merge. Merging stays double-gated outside the classifier: `gh pr merge` refuses a PR whose required checks are red, and the `address-pr-reviews` Finalize step only reaches the merge on its MergeAndChain arm, which a grant file on disk selects. Absent a covering grant or an explicit instruction, this rule does not apply and the merge stays blocked."
    ]
  },
  "voiceEnabled": true
}
