#!/usr/bin/env bash
# message-in-a-bottle — schedule a delayed self-message into the current
# tmux pane. The launcher returns immediately; a detached worker resets the
# context (/clear or /compact) and pastes the message after a fixed delay.
#
# Modes:
#   launcher:  message-in-a-bottle [message...]
#   worker:    message-in-a-bottle --worker <target> <reset> <msgfile>
#
# Reset is inferred from the message: if /compact appears within the first
# 3 sentences, compact is used; otherwise clear.

set -euo pipefail

# [LAW:one-source-of-truth] timing lives here once. Defaults are the production
# values; env overrides exist only so a live probe can shorten the delay without
# forking the script. The reset is not verified with a single fixed settle — a
# heavy (300k-token) session renders the post-reset banner well after any fixed
# wait, and a reset typed into a still-busy pane executes only once the agent
# goes idle. So both the pre-reset idle-wait and the post-reset banner check
# POLL up to a bound instead of sleeping a fixed interval and reading once.
BOTTLE_DELAY_SECONDS="${BOTTLE_DELAY_SECONDS:-10}"
POLL_INTERVAL_SECONDS="${POLL_INTERVAL_SECONDS:-1}"
IDLE_WAIT_SECONDS="${IDLE_WAIT_SECONDS:-20}"      # max wait for idle before reset
VERIFY_TIMEOUT_SECONDS="${VERIFY_TIMEOUT_SECONDS:-20}" # max wait for reset banner

# [LAW:one-source-of-truth] the static framing wrapped around the agent's message
# lives here once. The launcher composes PREFIX + agent message + SUFFIX into the
# single value that flows to the pane; the worker stays a dumb conduit. Edit the
# placeholder text between the markers — leave the surrounding heredoc mechanics.
BOTTLE_PREFIX=$(cat <<'PREFIX'
=== Below is a message from an agent on behalf of the user ===
PREFIX
)
BOTTLE_SUFFIX=$(cat <<'SUFFIX'
=== The above message was sent on behalf of the user, but as it was sent from an agent, double checking the claims is wise.  When in doubt, note any divergence and run the '/next' skill to proceed.  Do NOT ask the user if you should run '/next'. ===
SUFFIX
)

# [LAW:dataflow-not-control-flow] reset mode is a value inferred from the
# message, not a separate argument. Scan the first 3 sentences for /compact;
# stop early so long messages don't slow the common case.
_first_three_sentences() {
  local text="$1" result="" count=0 i char
  for ((i=0; i<${#text}; i++)); do
    char="${text:$i:1}"
    result+="$char"
    if [[ "$char" == "." || "$char" == "!" || "$char" == "?" ]]; then
      ((count++)) || true
      [[ $count -ge 3 ]] && break
    fi
  done
  printf '%s' "$result"
}

# [LAW:types-are-the-program] one discriminator at the entry; everything
# downstream operates on validated, typed inputs for exactly one mode.
if [[ "${1:-}" == "--worker" ]]; then
  MODE=worker
  shift
else
  MODE=launcher
fi

case "$MODE" in

  launcher)
    # [LAW:dataflow-not-control-flow] the message is a value carrying a canonical
    # default — /next, the standard "pull the next ticket" handoff. Omitting argv
    # selects that default; it never yields an empty bottle, so no guard follows.
    AGENT_MESSAGE="${*:-/next}"

    # [LAW:dataflow-not-control-flow] reset mode is derived from the message — if
    # /compact appears in the first 3 sentences, use compact; else clear. The mode
    # is a value the message carries, not a separate argument the caller decides.
    PROBE=$(_first_three_sentences "$AGENT_MESSAGE")
    if [[ "$PROBE" =~ (^|[[:space:]])/compact([[:space:]]|$) ]]; then
      RESET=compact
    else
      RESET=clear
    fi

    # [LAW:one-source-of-truth] the wrapped value is assembled once, here, from the
    # static framing and the agent's message. Everything downstream — MSGFILE,
    # buffer, paste — carries this final value verbatim and never re-wraps it.
    MESSAGE=$(printf '%s\n%s\n%s' "$BOTTLE_PREFIX" "$AGENT_MESSAGE" "$BOTTLE_SUFFIX")

    # [LAW:no-defensive-null-guards] the tmux context is a real trust boundary —
    # fail loudly when it's absent. The message needs no such guard: it carries a
    # canonical default and is non-empty by construction.
    [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] \
      || { echo "not inside tmux (\$TMUX/\$TMUX_PANE unset)" >&2; exit 2; }

    # [LAW:one-source-of-truth] target derived from $TMUX_PANE via tmux
    # itself — never accepted as a flag; tmux is the authority.
    TARGET=$(tmux display-message -p -t "$TMUX_PANE" \
      '#{session_name}:#{window_index}.#{pane_index}')

    # [LAW:dataflow-not-control-flow] the message flows through a tempfile
    # as a value, bypassing every shell-quoting hazard between argv → worker
    # → tmux load-buffer. No escaping branches anywhere.
    MSGFILE=$(mktemp -t bottle-msg.XXXXXX)
    LOGFILE=""
    # [LAW:single-enforcer] one trap covers both tempfiles until the worker
    # is spawned; cleared right after `nohup` so the worker owns MSGFILE and
    # the launcher's "log: ..." line is the only reference to LOGFILE.
    # ${LOGFILE:+...} elides the arg entirely while LOGFILE is still empty —
    # avoids passing "" to rm, which GNU coreutils warns about.
    trap 'rm -f -- "$MSGFILE" ${LOGFILE:+"$LOGFILE"}' EXIT
    printf '%s' "$MESSAGE" > "$MSGFILE"

    # Resolve own path for both ./script and PATH-lookup invocations.
    # `$0` lacks a slash on PATH lookup, so dirname/pwd would yield $PWD
    # — wrong. `command -v` does PATH resolution; for paths containing
    # slashes it returns as-is.
    if [[ "$0" == */* ]]; then
      SELF_RAW="$0"
    else
      SELF_RAW=$(command -v -- "$0") \
        || { echo "cannot resolve own path from \$0=$0" >&2; exit 2; }
    fi
    SELF="$(cd "$(dirname "$SELF_RAW")" && pwd)/$(basename "$SELF_RAW")"

    # LOGFILE created just before the spawn — short lifetime minimizes the
    # window where a signal or freak `>>` failure could leave it behind,
    # and the EXIT trap above covers it as a backstop until we clear it.
    LOGFILE=$(mktemp -t bottle-log.XXXXXX)

    # nohup ignores SIGHUP, redirected stdio keeps nohup.out from spawning,
    # and the backgrounded child gets reparented to init when this shell
    # exits — `disown` would be belt-and-suspenders, but with `set -e` a
    # disown failure would fire the trap and yank MSGFILE out from under
    # the running worker. Leaving disown out closes that race entirely.
    nohup "$SELF" --worker "$TARGET" "$RESET" "$MSGFILE" \
      </dev/null >>"$LOGFILE" 2>&1 &
    trap - EXIT

    echo "bottle scheduled → $TARGET (/$RESET) in ${BOTTLE_DELAY_SECONDS}s (log: $LOGFILE)"
    ;;

  worker)
    if [[ $# -ne 3 ]]; then
      echo "internal error: worker expects exactly 3 args" >&2
      exit 2
    fi
    TARGET="$1"
    RESET="$2"
    MSGFILE="$3"

    # [LAW:single-enforcer] launcher owns input validation (RESET value,
    # MSGFILE existence) AND log destination (via nohup stdout redirect).
    # `--worker` is a non-interface, not a public entry point, so the worker
    # does not re-check — duplicating those checks would be drift-prone
    # ceremony for states that cannot occur via the documented call path.
    BUFFER="bottle-$$"

    # [LAW:single-enforcer] the trap owns only the message file; the paste
    # buffer deletes itself on paste (paste-buffer -d).
    trap 'rm -f "$MSGFILE"' EXIT

    log() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }

    # [LAW:one-type-per-behavior] both harnesses share one worker path; only the
    # pane-marker values differ. Markers are OR'd unions of each harness's
    # app-generated chrome — never the echoed/queued command text — so a reset
    # swallowed as literal input cannot false-positive. Captured VISIBLE-only
    # (no -S): scrollback can still hold a prior session's banner.
    #
    # clear:
    #   Claude Code → startup banner "Claude Code vN"
    #   OpenCode    → empty-session prompt "Ask anything..." (/clear aliases /new)
    # compact:
    #   Claude Code → "Compacting conversation" / "Conversation compacted"
    #   OpenCode    → "Compaction" chrome (header during, "Compaction ·" after)
    case "$RESET" in
      clear)   REGISTERED_RE='Claude Code v[0-9]|Ask anything\.\.\.' ;;
      compact) REGISTERED_RE='Compacting conversation|Conversation compacted|Compaction' ;;
    esac

    # [LAW:types-are-the-program] "still working" is pane state, not a sleep.
    # Claude Code: live elapsed timer in parens — "(22s · …)"; done turns read
    # "Cooked for 8s" with no parens. OpenCode: footer "esc interrupt" while a
    # turn/compaction runs (distinct from Claude's "esc to interrupt").
    BUSY_RE='\([0-9]+s |esc interrupt'
    pane_busy() { tmux capture-pane -t "$TARGET" -p | grep -qE "$BUSY_RE"; }
    pane_reset() { tmux capture-pane -t "$TARGET" -p | grep -qE "$REGISTERED_RE"; }

    PANE_CMD=$(tmux display-message -p -t "$TARGET" '#{pane_current_command}' 2>/dev/null || echo '?')
    log "waking; target=$TARGET cmd=$PANE_CMD reset=/$RESET"
    sleep "$BOTTLE_DELAY_SECONDS"

    # [LAW:dataflow-not-control-flow] Escape cancels whatever was running — we
    # never inspect what; cancelling is the point.
    tmux send-keys -t "$TARGET" Escape
    sleep 1

    # [LAW:no-ambient-temporal-coupling] the reset must land on a ready prompt,
    # not a fixed guess at when the pane is free. Poll for idle up to a bound —
    # a reset typed into a busy pane queues as literal text and never registers.
    idle_waited=0
    while pane_busy && [ "$idle_waited" -lt "$IDLE_WAIT_SECONDS" ]; do
      sleep "$POLL_INTERVAL_SECONDS"
      idle_waited=$((idle_waited + POLL_INTERVAL_SECONDS))
    done

    tmux send-keys -t "$TARGET" "/$RESET"
    sleep 0.5
    tmux send-keys -t "$TARGET" Enter

    # [LAW:no-ambient-temporal-coupling] verify by POLLING for the banner, not a
    # single read after a fixed settle — a heavy session renders it seconds later
    # than a light one, and the fixed-window read is exactly what produced false
    # misfires. Succeeds the instant the banner appears, whatever the latency.
    verify_waited=0
    while ! pane_reset && [ "$verify_waited" -lt "$VERIFY_TIMEOUT_SECONDS" ]; do
      sleep "$POLL_INTERVAL_SECONDS"
      verify_waited=$((verify_waited + POLL_INTERVAL_SECONDS))
    done

    # [LAW:types-are-the-program] the message paste is reachable only after the
    # reset is verified to have run — it cannot land in an un-reset session.
    if pane_reset; then
      # Compact (esp. OpenCode) shows its marker while still busy; wait for idle
      # so the paste lands on a ready prompt rather than racing the compressor.
      settle_waited=0
      while pane_busy && [ "$settle_waited" -lt "$VERIFY_TIMEOUT_SECONDS" ]; do
        sleep "$POLL_INTERVAL_SECONDS"
        settle_waited=$((settle_waited + POLL_INTERVAL_SECONDS))
      done
      log "/$RESET registered after ${verify_waited}s (settle ${settle_waited}s); sending message"
      tmux load-buffer -b "$BUFFER" "$MSGFILE"
      tmux paste-buffer -d -b "$BUFFER" -t "$TARGET" -p
      sleep 0.5
      tmux send-keys -t "$TARGET" Enter
    elif pane_busy; then
      # [LAW:no-silent-failure] the reset never rendered AND the pane is still
      # busy — a queued reset may yet fire. Typing a note now would queue behind
      # it and leak into the resulting fresh session (the observed symptom).
      # Leave the pane untouched and surface the misfire only in this log.
      log "MISFIRE: /$RESET unconfirmed after ${verify_waited}s and pane still busy; pane left untouched"
    else
      log "MISFIRE: /$RESET did not register; message NOT sent"
      # Pane is idle with no banner: the reset was genuinely swallowed, nothing
      # is queued to fire late, so a note sent now stays in this live session
      # rather than leaking into a reset. A fixed string, so -l carries it directly.
      tmux send-keys -t "$TARGET" -l "message-in-a-bottle misfired: the scheduled /$RESET never registered, so the queued handoff was NOT sent. Please tell the user the bottle misfired."
      sleep 0.5
      tmux send-keys -t "$TARGET" Enter
    fi
    ;;
esac
