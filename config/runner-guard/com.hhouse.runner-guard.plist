<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent: circuit-breaks (and now recreates) crash-looping self-hosted CI
     runners, machine-wide.
     Install/stop: run ./install.sh in this directory (idempotent), or by hand:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.hhouse.runner-guard.plist
       launchctl bootout   gui/$(id -u)/com.hhouse.runner-guard
     Paths are absolute by this repo's convention (single-user machine); the scripts are
     the dotbot-linked ~/.config/{periodic,runner-guard}/.

     WHY KeepAlive AND NOT StartInterval
     This agent used to say `StartInterval 120`. It ran ONCE, on 2026-07-25, and never
     again: `launchctl print` showed `runs = 1` with a permanently pended nondemand spawn
     while a runner crash-looped 3,203 times underneath it, unnoticed for six weeks. Its
     sibling com.hhouse.ci-janitor had the identical signature. A controlled A/B probe on
     2026-09-04 settled the cause: a throwaway agent with `StartInterval 10` sat at
     `runs = 0` for three minutes without firing once, while an otherwise identical agent
     with `KeepAlive` ran continuously and ticked every 10s. launchd in this gui/501
     domain honours a demand spawn (`launchctl kickstart`) but does not execute the
     pended nondemand spawns an interval needs.

     So the agent no longer asks launchd to start it 720 times a day. It asks launchd to
     start it ONCE and keep it alive — the job launchd actually does — and periodic.sh
     owns the clock from there, stamping a heartbeat every cycle so that a dead guard is
     visible instead of merely quiet. install.sh refuses to finish until that heartbeat
     has actually advanced. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hhouse.runner-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/hhouse/.config/periodic/periodic.sh</string>
    <string>--label</string>
    <string>runner-guard</string>
    <string>--interval</string>
    <string>120</string>
    <!-- One cycle may sample a 20s window and then recreate up to three runners, each
         with a pull and a 25s verification hold. 900s is well clear of that, and still
         bounds a cycle wedged on an unresponsive Docker socket — the hang KeepAlive
         cannot see, because the process is alive while nothing is happening. -->
    <string>--timeout</string>
    <string>900</string>
    <string>--heartbeat</string>
    <string>/Users/hhouse/.local/share/runner-guard/heartbeat</string>
    <string>--</string>
    <string>/bin/bash</string>
    <string>/Users/hhouse/.config/runner-guard/runner-guard.sh</string>
  </array>
  <!-- launchd hands agents a bare PATH; docker (via Colima/Homebrew) is in
       /opt/homebrew/bin. Without this every cycle fails LOUDLY but uselessly — the
       guard's `docker info` check catches the 'command not found' and dies with a
       FATAL line in guard.log/launchd.err, exit 2 — never doing its job. So install.sh
       verifies docker against THIS exact PATH (its single source) before loading. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/hhouse/.local/share/runner-guard/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/hhouse/.local/share/runner-guard/launchd.err</string>
</dict>
</plist>
